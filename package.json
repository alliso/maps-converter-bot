{
  "name": "maps-converter-bot",
  "version": "0.1.0",
  "description": "Bot de Telegram que convierte enlaces de Apple Maps, Google Maps y Waze entre sí.",
  "license": "MIT",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:mutation": "stryker run",
    "typecheck": "tsc --noEmit"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "current"
          }
        }
      ],
      "@babel/preset-typescript"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/__tests__/**",
      "!src/maps/types.ts",
      "!src/index.ts"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 95,
        "branches": 90,
        "functions": 95,
        "lines": 95
      }
    }
  },
  "dependencies": {
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.1",
    "babel-jest": "^30.5.1",
    "jest": "^30.5.1",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
