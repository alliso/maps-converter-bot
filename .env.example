# Token que da @BotFather.
BOT_TOKEN=123456:ABC-DEF...

# Deja las dos vacías para long polling (lo normal en local).
# Con WEBHOOK_URL puesta, el bot levanta un servidor HTTP y registra el webhook.
WEBHOOK_URL=
PORT=3000

# Opcional: Telegram lo manda en X-Telegram-Bot-Api-Secret-Token y el bot
# rechaza lo que no lo traiga. Recomendado si expones el webhook a internet.
WEBHOOK_SECRET=
